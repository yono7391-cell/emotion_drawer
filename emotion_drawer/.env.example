# 이 파일을 복사해 .env 로 만들고 값을 채우세요. (.env 는 다른 사람과 공유하지 마세요)
# run.bat 을 실행하면 .env 가 없을 때 비밀 키를 자동으로 만들어 줍니다.

# 세션 암호화용 비밀 키. 길고 임의의 문자열 (예: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# GA4 측정 ID (G-로 시작). 비워 두면 GA4로 아무것도 보내지 않습니다.
GA4_MEASUREMENT_ID=

# 1 이면 개발 모드(코드를 고치면 자동 재시작), 0 이면 끔
FLASK_DEBUG=1
